{
  "name": "vite-electron-template",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev:web": "vite",
    "build:web": "vue-tsc -b && vite build",
    "dev:electron": "cross-env VITE_ELECTRON_MODE=true vite",
    "build:electron": "rimraf dist-release && vue-tsc -b && cross-env VITE_ELECTRON_MODE=true vite build && electron-builder"
  },
  "dependencies": {
    "axios": "1.18.1",
    "dayjs": "1.11.21",
    "element-plus": "2.14.2",
    "pinia": "3.0.4",
    "vue": "^3.5.39",
    "vue-router": "5.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.9.1",
    "cross-env": "10.1.0",
    "electron": "43.0.0",
    "electron-builder": "26.15.3",
    "rimraf": "6.1.3",
    "sass": "1.101.0",
    "typescript": "~6.0.3",
    "unocss": "66.7.4",
    "unplugin-auto-import": "21.0.0",
    "unplugin-element-plus": "0.11.2",
    "unplugin-vue-components": "32.1.0",
    "vite": "^8.1.3",
    "vite-plugin-electron": "1.1.0",
    "vite-plugin-svg-icons-ng": "1.9.1",
    "vue-tsc": "^3.3.6"
  }
}
