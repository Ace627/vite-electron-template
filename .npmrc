# Electron 国内镜像：pnpm <= 10 会转成 npm_config_electron_mirror 传给安装脚本
# 注意：pnpm 11+ 起生命周期脚本不再注入 npm_config_*，这两项在新版下不会生效；
# 新版请改用环境变量 ELECTRON_MIRROR / ELECTRON_BUILDER_BINARIES_MIRROR
# （或在 electron-builder.yaml 配 electronDownload.mirror）
electron_mirror = https://npmmirror.com/mirrors/electron/
electron_builder_binaries_mirror = https://npmmirror.com/mirrors/electron-builder-binaries/
